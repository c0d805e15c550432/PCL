<local:MyPageRight x:Class="PageInstanceSchematic"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" PanScroll="PanBack">
    <Grid>
        <local:MyScrollViewer x:Name="PanBack" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PanMain" Margin="25,10,25,10" Grid.IsSharedSizeScope="True">
                <local:MySearchBox x:Name="SearchBox" Margin="0,15" HintText="搜索投影名称 / 文件夹 / 格式" />
                <local:MyCard x:Name="PanManage" Margin="0,0,0,15">
                    <Grid Margin="15,15,0,15" Height="35">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                            <ColumnDefinition Width="Auto" SharedSizeGroup="Button" />
                        </Grid.ColumnDefinitions>
                        <local:MyButton x:Name="BtnFolder" Text="打开文件夹" MinWidth="110" Padding="13,0" Margin="0,0,15,0" HorizontalAlignment="Left" ColorType="Highlight" />
                        <local:MyButton x:Name="BtnImport" Grid.Column="1" Text="从文件导入" MinWidth="110" Padding="13,0" Margin="0,0,15,0" HorizontalAlignment="Left" />
                        <local:MyButton x:Name="BtnRefresh" Grid.Column="2" Text="刷新投影" MinWidth="110" Padding="13,0" Margin="0,0,15,0" HorizontalAlignment="Left" />
                        <local:MyButton x:Name="BtnSelectAll" Grid.Column="3" Text="全选" MinWidth="110" Padding="13,0" Margin="0,0,15,0" HorizontalAlignment="Left" />
                    </Grid>
                </local:MyCard>
                <local:MyCard x:Name="PanListBack" VerticalAlignment="Top" Margin="0,0,0,14" Title=" " MinHeight="55">
                    <StackPanel x:Name="PanFilter" Margin="15,13,0,0" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Left" Height="28">
                        <local:MyRadioButton x:Name="BtnFilterAll" Tag="" Text="全部" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0" Checked="True" />
                        <local:MyRadioButton x:Name="BtnFilterLitematic" Tag="LITEMATIC" Text="Litematica" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0" />
                        <local:MyRadioButton x:Name="BtnFilterLegacy" Tag="SCHEMATIC" Text="Schematic" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0" />
                        <local:MyRadioButton x:Name="BtnFilterSponge" Tag="SCHEM" Text="Sponge" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0" />
                        <local:MyRadioButton x:Name="BtnFilterNbt" Tag="NBT" Text="结构 NBT" ColorType="Highlight" VerticalAlignment="Center" Margin="2,0" />
                    </StackPanel>
                    <StackPanel Margin="20,48,18,22" VerticalAlignment="Top">
                        <TextBlock x:Name="LabStatus" Text="正在加载投影列表…" Margin="4,8" TextWrapping="Wrap" Foreground="{DynamicResource ColorBrushGray4}" />
                        <StackPanel x:Name="PanList" />
                    </StackPanel>
                </local:MyCard>
            </StackPanel>
        </local:MyScrollViewer>
        <local:MyCard x:Name="CardSelect" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="25,25,25,10" UseAnimation="False">
            <TextBlock x:Name="LabSelect" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="9" Foreground="{DynamicResource ColorBrush2}" />
            <StackPanel Orientation="Horizontal" Margin="5,28,5,5">
                <local:MyIconTextButton x:Name="BtnDetails" Text="详情" Logo="M8 0A8 8 0 1 0 8 16A8 8 0 1 0 8 0M7 3H9V5H7ZM7 7H9V13H7Z" />
                <local:MyIconTextButton x:Name="BtnExport" Text="导出" Logo="M7 1H9V9L12 6L14 8L8 14L2 8L4 6L7 9ZM1 14H15V16H1Z" />
                <local:MyIconTextButton x:Name="BtnRename" Text="重命名" Logo="M1 11L11 1L15 5L5 15L0 16ZM10 2L14 6" />
                <local:MyIconTextButton x:Name="BtnDelete" Text="删除" Logo="M2 4H14V6H13V16H3V6H2ZM5 0H11V2H15V4H1V2H5ZM5 6V14H7V6ZM9 6V14H11V6Z" />
                <local:MyIconTextButton x:Name="BtnCancel" Text="取消选择" Logo="M2 0L8 6L14 0L16 2L10 8L16 14L14 16L8 10L2 16L0 14L6 8L0 2Z" />
            </StackPanel>
        </local:MyCard>
    </Grid>
</local:MyPageRight>
