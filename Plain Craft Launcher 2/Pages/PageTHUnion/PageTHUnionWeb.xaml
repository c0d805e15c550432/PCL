<local:MyPageRight x:Class="PageTHUnionWeb"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL">
    <Grid Margin="25,25,25,20">
        <local:MyCard>
            <Grid x:Name="BrowserHost" Margin="1" ClipToBounds="True" />
        </local:MyCard>
        <Border x:Name="StatusPanel" Background="{DynamicResource ColorBrush8}" CornerRadius="5" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
            <StackPanel>
                <local:MyLoading x:Name="Loading" Text="正在加载网页" TextError="加载失败，点击重试" TextErrorInherit="False" Click="Retry" />
                <TextBlock x:Name="LabStatus" Margin="0,16,0,0" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
        </Border>
        <!-- CompositionControl 允许 WPF 按钮始终绘制在网页之上，且不随网页滚动。 -->
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="4" CornerRadius="5" Background="{DynamicResource ColorBrush8}" Panel.ZIndex="10">
            <local:MyButton Text="在浏览器中打开" Width="145" Height="35" Click="OpenBrowser" />
        </Border>
    </Grid>
</local:MyPageRight>
