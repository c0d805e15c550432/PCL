<local:MyPageLeft x:Class="PageTHUnionLeft"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:PCL" AnimatedControl="PanItem">
    <local:MyScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource ScrollViewerFullMargin}">
        <StackPanel x:Name="PanItem" Margin="0,12,0,12">
            <TextBlock Text="三周目" Margin="20,8,20,5" FontSize="12" Foreground="{DynamicResource ColorBrush3}" />
            <local:MyListItem x:Name="ItemOnline" Title="在线列表" Tag="0" Type="RadioBox" Checked="True" Height="36" MinPaddingRight="24" IsScaleAnimationEnabled="False" />
            <local:MyListItem x:Name="ItemMap" Title="实时地图" Tag="1" Type="RadioBox" Height="36" MinPaddingRight="24" IsScaleAnimationEnabled="False" />
            <local:MyListItem x:Name="ItemIndustry" Title="工业设施导引" Tag="2" Type="RadioBox" Height="36" MinPaddingRight="24" IsScaleAnimationEnabled="False" />
            <TextBlock Text="其他" Margin="20,20,20,5" FontSize="12" Foreground="{DynamicResource ColorBrush3}" />
            <local:MyListItem x:Name="ItemWiki" Title="Wiki首页" Tag="3" Type="RadioBox" Height="36" MinPaddingRight="24" IsScaleAnimationEnabled="False" />
            <local:MyListItem x:Name="ItemServers" Title="服务器列表" Tag="4" Type="RadioBox" Height="36" MinPaddingRight="24" IsScaleAnimationEnabled="False" />
            <local:MyListItem x:Name="ItemSecond" Title="二周目" Tag="5" Type="RadioBox" Height="36" MinPaddingRight="24" IsScaleAnimationEnabled="False" />
            <local:MyListItem x:Name="ItemFirst" Title="一周目" Tag="6" Type="RadioBox" Height="36" MinPaddingRight="24" IsScaleAnimationEnabled="False" />
            <local:MyListItem x:Name="ItemRules" Title="部门规章制度" Tag="7" Type="RadioBox" Height="36" MinPaddingRight="24" IsScaleAnimationEnabled="False" />
        </StackPanel>
    </local:MyScrollViewer>
</local:MyPageLeft>
